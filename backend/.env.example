# .env.example
# Copy this file to .env and fill in real values.
# NEVER commit the .env file — it is already in .gitignore.

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: https://threatlens1.netlify.app,http://localhost:5500
FRONTEND_ORIGIN=https://threatlens1.netlify.app

# ── Flask ─────────────────────────────────────────────────────────────────────
# Set to "development" for local dev mode. Leave as "production" on Render.
FLASK_ENV=production

# ── Port (Render injects this automatically) ───────────────────────────────────
# PORT=10000

# ── Future API Keys (add here, never commit actual values) ────────────────────
# VIRUSTOTAL_API_KEY=
# GOOGLE_SAFE_BROWSING_KEY=
